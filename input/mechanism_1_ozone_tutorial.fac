********************************************************************** ;
* Day 35 对流层臭氧光化学机制 (NOx-ROx-O3 循环骨架, FACSIMILE 子集)      * ;
* 定位: 非 MCM —— 教学级精简, 但三大循环完整:                           * ;
*   ① Leith-type NOx 光解循环: NO2+hv→NO+O, O+O2+M→O3, O3+NO→NO2 (O3 生成且不净耗) ;
*   ② HOx 循环: O1D+H2O→2OH 起爆, CO/CH4/HCHO 氧化泵浦 HO2, HO2+NO→NO2+OH (O3 净生成) ;
*   ③ ROx(甲烷链) 循环: CH4+OH→CH3O2, CH3O2+NO→CH3O+NO2, CH3O+O2→HCHO+HO2 ;
* 元素守恒: C/H/N 逐反应闭合 (day35_twin T2 审计的前提)               * ;
* 简化决策(教学): 无 NO3/N2O5/PAN/异戊二烯; CO2 与 H2O 视为定常背景     * ;
********************************************************************** ;
*;
* Variable definitions. All species are listed here. ;
*;
VARIABLE
NO NO2 O3 O1D O OH HO2 H2O2 CO HCHO CH4 CH3O2 CH3OOH CH3O HNO3 ;
*;
* Generic Rate Coefficients ;
*;
KNO2OH = 1.1D-11 ;
KCH4OH = 2.45D-12*EXP(-1775/TEMP) ;
KCOOH = 2.4D-13 ;
KHCHOOH = 1.0D-11 ;
KHO2NO = 8.6D-12*EXP(270/TEMP) ;
KHO2HO2 = 2.9D-13*EXP(1300/TEMP) ;
KH2O2OH = 1.8D-12 ;
KHO2CH3O2 = 3.8D-13*EXP(900/TEMP) ;
KCH3O2NO = 4.9D-12*EXP(340/TEMP) ;
KO1DM = 2.9D-11 ;
KO1DH2O = 2.2D-10 ;
KO3NO = 1.4D-12*EXP(-1310/TEMP) ;
KO3NO2 = 1.2D-13*EXP(-2450/TEMP) ;
KONO2 = 1.0D-11 ;
*;
* Peroxy radicals. ;
*;
RO2 = CH3O2 ;
*;
* Reaction definitions. ;
*;
% J<1> : NO2 = NO + O ;
% J<2> : O3 = O1D ;
% J<3> : O3 = O ;
% J<4> : HCHO = HO2 + HO2 + CO ;
% J<5> : H2O2 = OH + OH ;
% J<6> : HNO3 = NO2 + OH ;
% J<7> : CH3OOH = HCHO + HO2 + OH ;
% 6.0D-34*(TEMP/300)@-2.6*M*O2 : O + O2 + M = O3 ;
% KO3NO : O3 + NO = NO2 ;
% KO3NO2 : O3 + NO2 = NO ;
% KONO2 : O + NO2 = NO ;
% KNO2OH : NO2 + OH = HNO3 ;
% KO1DH2O : O1D + H2O = OH + OH ;
% KO1DM : O1D + M = O ;
% KCOOH : CO + OH = HO2 ;
% KHCHOOH : HCHO + OH = HO2 + CO + H2O ;
% KHO2NO : HO2 + NO = NO2 + OH ;
% KHO2HO2 : HO2 + HO2 = H2O2 + O2 ;
% KH2O2OH : H2O2 + OH = HO2 + H2O ;
% 4.8D-11*EXP(250/TEMP) : OH + HO2 = H2O + O2 ;
% KCH4OH : CH4 + OH = CH3O2 + H2O ;
% KCH3O2NO : CH3O2 + NO = CH3O + NO2 ;
% KHO2CH3O2 : CH3O2 + HO2 = CH3OOH + O2 ;
% 5.3D-12 : CH3OOH + OH = HCHO + OH + H2O ;
% 7.3D-13*EXP(580/TEMP) : CH3O + O2 = HCHO + HO2 ;
