# ═══════════════════════════════════════════════════════════════
# ozone_lab .gitignore
# 原则: 只提交源码/配置/文档/机制图；不提交编译产物与运行输出
# ═══════════════════════════════════════════════════════════════

# ── 编译产物 ──
*.o
*.mod
*.so
*.dylib
*.a
facsimile_impl/fac_v3
facsimile_impl/fac_batch_omp
mcm_city/mcm_run
modules/rad_photol_demo

# ── 自动生成的机制代码（由 mechc.py 从 .fac 重新生成）──
facsimile_impl/gen/oz_mech.f90
facsimile_impl/gen/oz.reac
facsimile_impl/gen/oz.prod
facsimile_impl/gen_v3/oz_mech.f90
facsimile_impl/gen_v3/oz.reac
facsimile_impl/gen_v3/oz.prod
mcm_city/gen/oz_mech.f90
mcm_city/gen/oz.reac
mcm_city/gen/oz.prod

# ── 编译出的配置平面文件（由 cfgbuild.py 从各程序 config_override/ 重新生成）──
runtime.dat
runtime_v3.dat

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 运行输出（三个程序各自的 output/：CSV、PNG、runtime、临时装配目录）──
# 全部是"跑出来的"再生内容，可由各程序 run.py 重生成，不入库。
output/
outp_*.csv
*.nc

# ── 图件输出 ──
# 各程序 output/*.png（随上面的 output/ 一起忽略；脚本 = 各程序 plot.py）

# ── 系统/编辑器杂物 ──
# .DS_Store 无斜杠前缀 → 匹配任意层级（含 mechanism/.DS_Store）
.DS_Store
**/.DS_Store
*.swp
*~
.idea/
.vscode/
*.sublime-*

# ── 个人环境与密钥（安全兜底）──
.env
.env.*
*credential*
*secret*
*api_key*
*apikey*
*.pem
*.key
*.p12
.zcode/
.mcp.json
