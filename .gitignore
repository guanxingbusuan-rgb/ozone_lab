# ═══════════════════════════════════════════════════════════════
# ozone_lab .gitignore
# 原则: 只提交源码/配置/文档/机制图；不提交编译产物与运行输出
# ═══════════════════════════════════════════════════════════════

# ── 编译产物 ──
*.o
*.mod
*.so
*.dylib
*.a
facsimile_impl/fac_v3
facsimile_impl/fac_batch_omp
mcm_city/mcm_run
modules/rad_photol_demo

# ── 自动生成的机制代码（由 mechc.py 从 .fac 重新生成）──
facsimile_impl/gen/oz_mech.f90
facsimile_impl/gen/oz.reac
facsimile_impl/gen/oz.prod
facsimile_impl/gen_v3/oz_mech.f90
facsimile_impl/gen_v3/oz.reac
facsimile_impl/gen_v3/oz.prod
mcm_city/gen/oz_mech.f90
mcm_city/gen/oz.reac
mcm_city/gen/oz.prod

# ── 编译出的配置平面文件（由 cfgbuild.py 从 input*/ 重新生成）──
runtime.dat
runtime_v3.dat

# ── Python 缓存 ──
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ── 运行输出（实验产物，可由 experiments/run/ 重生成）──
# output/ = 实验 CSV 落盘目录（run_A..run_M 全部产物）
# 是"跑出来的"再生内容，不入库。
# (audit_reports/ 已于 2026-10-26 删除：5 份分轮报告均为 V2.3 时代过程记录，
#  结论已 100% 合并进 AUDIT_COMPLETE.md，不再保留原始文件。)
output/
outp_*.csv
*.nc

# ── 图件输出 ──
# 工程图：output/*.png（随 output/ 忽略；脚本在 experiments/viz/，可用 make figures 重生成）
# 机制图：docs/figures/*.pdf|png（静态归档，入库；教学手册 docs/figures/README.md）

# ── 系统/编辑器杂物 ──
# .DS_Store 无斜杠前缀 → 匹配任意层级（含 mechanism/.DS_Store）
.DS_Store
**/.DS_Store
*.swp
*~
.idea/
.vscode/
*.sublime-*

# ── 个人环境与密钥（安全兜底）──
.env
.env.*
*credential*
*secret*
*api_key*
*apikey*
*.pem
*.key
*.p12
.zcode/
.mcp.json
