# 气象: 7 个量, 每个都可以写"常数"或 "file:constraints/xx.txt" 逐时序列
# ─────────────────────────────────────────────────────────────────────
# 默认(下面 8 行) = 常数为主 + BLH/RAIN 走示波序列 (5 天快照, 7 点)
# 想切换到"站点逐时观测"驱动, 看文件末尾的注释块 (6 条 121 点样例已备好)
# 气象序列格式与 BC 序列相同 (t[s] + 值), 但不要写浓度单位指令行
# ─────────────────────────────────────────────────────────────────────
TEMP   = 298.15
PRES   = 1013.25
RH     = 60
RADIAT = 0
BLH    = file:constraints/met_BLH.txt
RAIN   = file:constraints/met_RAIN.txt
JFAC   = 1.0

# ═════════════════════════════════════════════════════════════════════
# 可选: 六变量全部走站点逐时序列 (见 input_v3/constraints/met_*_demo.txt)
# ─────────────────────────────────────────────────────────────────────
# 把上面 7 行换成下面 6 行即可; 配套实验: python experiments/run/run_M_met_series.py
#
#   TEMP   = file:constraints/met_TEMP_demo.txt   # K    气温
#   PRES   = file:constraints/met_PRES_demo.txt   # hPa  气压
#   RH     = file:constraints/met_RH_demo.txt     # %    相对湿度
#   BLH    = file:constraints/met_BLH_demo.txt    # m    边界层高度
#   RAIN   = file:constraints/met_RAIN_demo.txt   # mm/h 降水
#   JFAC   = file:constraints/met_JFAC_demo.txt   # 1    光解衰减 (云)
#   RADIAT = 0                                    # 当前无消费者, 留位
#
# 硬限制: 气象序列与 BC 序列共享一个上限 8 的池子 (runtime_dat_mod NSER_MAX)
# 因此若同时启用 6 个气象序列, BC 侧最多再用 2 个 file: 约束。
# ═════════════════════════════════════════════════════════════════════
