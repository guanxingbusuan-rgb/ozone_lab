* ;
* ---- 通用速率常数 (MCM v3.3.1 逐字拷贝部分注明 [MCM]) ----  ;
* ;
* [MCM] Troe 基元: N2O5 生成 KMT03 / 热解 KMT04  ;
K30 = 3.6D-30*M*(TEMP/300)@-4.1  ;
K3I = 1.9D-12*(TEMP/300)@0.2  ;
KR3 = K30/K3I  ;
FC3 = 0.35  ;
NC3 = 0.75-1.27*(LOG10(FC3))  ;
F3 = 10@(LOG10(FC3)/(1+(LOG10(KR3)/NC3)@2))  ;
KMT03 = (K30*K3I)*F3/(K30+K3I)  ;
K40 = 1.3D-3*M*(TEMP/300)@-3.5*EXP(-11000/TEMP)  ;
K4I = 9.7D+14*(TEMP/300)@0.1*EXP(-11080/TEMP)  ;
KR4 = K40/K4I  ;
FC4 = 0.35  ;
NC4 = 0.75-1.27*(LOG10(FC4))  ;
F4 = 10@(LOG10(FC4)/(1+(LOG10(KR4)/NC4)@2))  ;
KMT04 = (K40*K4I)*F4/(K40+K4I)  ;
* [MCM] Troe: OH+NO=HONO KMT07 / OH+NO2=HNO3 KMT08  ;
K70 = 7.4D-31*M*(TEMP/300)@-2.4  ;
K7I = 3.3D-11*(TEMP/300)@-0.3  ;
KR7 = K70/K7I  ;
FC7 = 0.81  ;
NC7 = 0.75-1.27*(LOG10(FC7))  ;
F7 = 10@(LOG10(FC7)/(1+(LOG10(KR7)/NC7)@2))  ;
KMT07 = (K70*K7I)*F7/(K70+K7I)  ;
K80 = 3.2D-30*M*(TEMP/300)@-4.5  ;
K8I = 3.0D-11  ;
KR8 = K80/K8I  ;
FC8 = 0.41  ;
NC8 = 0.75-1.27*(LOG10(FC8))  ;
F8 = 10@(LOG10(FC8)/(1+(LOG10(KR8)/NC8)@2))  ;
KMT08 = (K80*K8I)*F8/(K80+K8I)  ;
* [MCM] PAN 生成/热解 (KC0/KCI 生成, KD0/KDI 热解)  ;
KC0 = 3.28D-28*M*(TEMP/300)@-6.87  ;
KCI = 1.125D-11*(TEMP/300)@-1.105  ;
KRC = KC0/KCI  ;
FCC = 0.30  ;
NC = 0.75-1.27*(LOG10(FCC))  ;
FC = 10@(LOG10(FCC)/(1+(LOG10(KRC)/NC)@2))  ;
KFPAN = (KC0*KCI)*FC/(KC0+KCI)  ;
KD0 = 1.10D-05*M*EXP(-10100/TEMP)  ;
KDI = 1.90D17*EXP(-14100/TEMP)  ;
KRD = KD0/KDI  ;
FCD = 0.30  ;
NCD = 0.75-1.27*(LOG10(FCD))  ;
FD = 10@(LOG10(FCD)/(1+(LOG10(KRD)/NCD)@2))  ;
KBPAN = (KD0*KDI)*FD/(KD0+KDI)  ;
* [MCM] 水汽增强因子 KMT06 + HO2 自缔合双通道  ;
KMT06 = 1 + (1.40D-21*EXP(2200/TEMP)*H2O)  ;
KHO2HO2A = 2.20D-13*KMT06*EXP(600/TEMP)  ;
KHO2HO2B = 1.90D-33*M*KMT06*EXP(980/TEMP)  ;
* [MCM] OH+HNO3 压力依赖 (KMT11 = K1+K2)  ;
K1H = 2.40D-14*EXP(460/TEMP)  ;
K3H = 6.50D-34*EXP(1335/TEMP)  ;
K4H = 2.70D-17*EXP(2199/TEMP)  ;
K2H = (K3H*M)/(1+(K3H*M/K4H))  ;
KMT11 = K1H + K2H  ;
* [MCM] 通用 RO2 速率  ;
KRO2NO = 2.7D-12*EXP(360/TEMP)  ;
KRO2HO2 = 2.91D-13*EXP(1300/TEMP)  ;
KRO2NO3 = 2.3D-12  ;
KNO3AL = 1.4D-12*EXP(-1860/TEMP)  ;
* ;
* ---- 无机核心速率 (JPL 推荐) ----  ;
KCH4OH = 2.45D-12*EXP(-1775/TEMP)  ;
KCOOH = 1.44D-13*(1+(M/4.2D19))  ;
KHCHOOH = 5.4D-12*EXP(135/TEMP)  ;      ! MCM v3.3.1 (旧写死 1.0e-11, 偏快 18%)
KHO2NO = 3.45D-12*EXP(270/TEMP)  ;      ! MCM/JPL (旧 8.6e-12 偏快 2.5 倍)
KH2O2OH = 1.8D-12  ;
KO1DM = 2.9D-11*M  ;
KO1DH2O = 2.2D-10*H2O  ;
KO3NO = 1.4D-12*EXP(-1310/TEMP)  ;
KO3NO2NO3 = 1.4D-13*EXP(-2470/TEMP)  ;
KONO2 = 5.5D-12*EXP(188/TEMP)  ;        ! MCM KMT02 低压极限 (旧偏快 20%)
KHONOOH = 2.5D-12*EXP(260/TEMP)  ;
* ;
* ---- isoprene 链速率 (JPL/Atkinson) ----  ;
KISOPOH = 2.7D-11*EXP(390/TEMP)  ;
KISOPO3 = 1.28D-17  ;                 ! Atkinson 298K; Criegee OH 产率 0.26 (ISOP)/0.30 (OLE)
KISOPNO3 = 3.03D-12*EXP(-446/TEMP)  ;
KISOPBO2NO = 4.0D-12  ;
KMVKOH = 2.6D-12*EXP(610/TEMP)  ;       ! MCM 总速率 (0.3+0.7)
KMACROH = 8.0D-12*EXP(380/TEMP)  ;      ! MCM 总速率 (0.45+0.47+0.08)
KMGLYOH = 1.9D-12*EXP(575/TEMP)  ;      ! MCM MGLYOX+OH (旧漏 EXP 项, 偏慢 7x)
KMPANTH = 1.6D+16*EXP(-13500/TEMP)  ;   ! MCM (旧 D-3 写错 → 慢 19 量级)
* ;
* ---- 硫链速率 ----  ;
KSO2OH = 9.0D-13  ;
KSO3HYD = 1.0D-2  ;
KDMSOH = 1.12D-11*EXP(-250/TEMP)  ;     ! MCM 加成通道 (旧偏慢 3 倍)
KDMSNO3 = 1.9D-13*EXP(520/TEMP)  ;
* ;
* ---- 卤素速率 (JPL) ----  ;
KCLO3 = 2.3D-11*EXP(-200/TEMP)  ;
KCLONO = 6.4D-12*EXP(290/TEMP)  ;
KCLONO2 = 1.6D-12  ;
KCLOHO2 = 2.2D-12*EXP(300/TEMP)  ;
KCLCH4 = 9.6D-12*EXP(-1140/TEMP)  ;
KCLHCHO = 8.1D-11*EXP(-34/TEMP)  ;
KHCLOH = 7.8D-13*EXP(-290/TEMP)  ;
KBRO3 = 1.6D-12*EXP(-780/TEMP)  ;
KBRONO = 8.7D-12*EXP(260/TEMP)  ;
KBRONO2 = 1.5D-12  ;
KBROHO2 = 2.5D-12*EXP(520/TEMP)  ;
KBRHCHO = 3.4D-12*EXP(-640/TEMP)  ;
KHBROH = 1.1D-11  ;
* ---- V2.2: VOC 降解谱集总类速率 (烯烃/烷烃/芳烃/酮) ----  ;
KOLEOH = 2.6D-11  ;                    ! 丙烯代理 (C3H6 一致)  ;
KOLEO3 = 1.0D-17  ;                    ! 烯烃臭氧化集总  ;
KOLENO3 = 9.4D-15  ;                   ! 夜交通 NO3 加成 (丙烯)  ;
KALKOH = 1.1D-12  ;                    ! C3H8 代理  ;
KARO1OH = 5.6D-12  ;                   ! 甲苯+OH (MCM)  ;
KARO2OH = 2.31D-11  ;                   ! MCM MXYL+OH 总速率 (旧 1.3e-11 偏慢 1.8x)                   ! 二甲苯+OH  ;
KKETOH = 8.8D-12*EXP(-1320/TEMP)+1.7D-14*EXP(423/TEMP)  ; ! MCM CH3COCH3+OH 双通道                    ! 丙酮+OH (MCM)  ;
KPNAF = 1.4D-12  ;                     ! HO2+NO2+M (低温显著)  ;
KOHPNA = 4.5D-12  ;                    ! PNA+OH 汇 (JPL ~4.5e-12 @298K)  ;
KRONO2OH = 1.2D-12  ;                  ! RONO2+OH (集总烷基硝酸酯)  ;
KOLENITOH = 1.2D-12  ;                 ! OLENIT+OH  ;
KTERPOH = 1.2D-11*EXP(440/TEMP)  ;      ! MCM APINENE+OH 总速率 (旧 1.2e-10 偏快 2.3x)                   ! 单萜+OH (扩散控制级, pinene)  ;
KTERPO3 = 8.05D-16*EXP(-640/TEMP)  ;    ! MCM APINENE+O3 (旧 8e-17 近似值, 差 15%)                   ! 单萜+O3 (高 OH 产率 ~0.8)  ;
KTERPNO3 = 1.2D-12*EXP(490/TEMP)  ;     ! MCM APINENE+NO3 (旧 3.8e-12 偏慢 1.6x)                  ! 单萜+NO3 (夜间主要汇)  ;
KPNAT = 1.3D+16*EXP(-10400/TEMP)  ;
* ---- V2.5-pre: MCM 官方 CH3O2 专属速率 + KAPHO2 ----  ;
KAPHO2 = 5.2D-13*EXP(980/TEMP)  ;        ! 酰基过氧 + HO2 通用
KCH3O2NO = 2.3D-12*EXP(360/TEMP)  ;      ! CH3O2+NO 专用 (通用 KRO2NO = 2.7e-12)
KCH3O2NO3 = 1.2D-12  ;                   ! CH3O2+NO3 专用 (通用 KRO2NO3 = 2.3e-12)
KCH3O2HO2 = 3.8D-13*EXP(780/TEMP)*(1-1/(1+498*EXP(-1160/TEMP)))  ;  ! CH3O2+HO2 专用

* ;
* Peroxy radicals.  ;
* ;
RO2 = CH3O2 CH3CO3 ISOPBO2 ISOPNO3 MVKO2 MACRO2  ;
* ;
* ---- V2.4 新增速率 (JPL/MCM 量级) ---- ;
KCSLOH = 1.4D-11  ;
KCSLNO3 = 1.4D-11  ;
KMEOHOH = 9.0D-13  ;
KETOHOH = 3.2D-12*EXP(70/TEMP)  ;
KLALKOH = 5.2D-12*EXP(405/TEMP)  ;
KMTBEOH = 2.3D-12  ;
KESTEROH = 1.7D-12  ;
KSESQOH = 1.9D-10  ;
KSESQO3 = 1.2D-14  ;                    ! MCM BCARY+O3 (旧 1.2e-16 偏慢 100x — 严重)
KSESQNO3 = 1.9D-11  ;                   ! MCM BCARY+NO3 (旧 4e-11 偏快 2.1x)
KETHOH = 8.5D-12*EXP(70/TEMP)  ;
KETHO3 = 1.6D-18  ;
KALD2OH = 1.9D-11  ;
KIOLEOH = 6.4D-11  ;
KIOLEO3 = 3.22D-15*EXP(-968/TEMP)  ;    ! MCM CBUT2ENE+O3 (旧 6e-18 偏慢 21x)
* ;
* Reaction definitions.  ;
* ;
* ---- ① 无机核心: NOx 光稳态 + HOx + HONO 晨爆 ----  ;
% J<4> : NO2 = NO + O  ;
% J<1> : O3 = O1D  ;
% J<2> : O3 = O  ;
% J<3> : H2O2 = OH + OH  ;
% J<8> : HNO3 = NO2 + OH  ;
% J<7> : HONO = NO + OH  ;
% 6.0D-34*(TEMP/300)@-2.6*M*O2 : O + O2 + M = O3  ;
% KO3NO : O3 + NO = NO2  ;
% KO3NO2NO3 : O3 + NO2 = NO3  ;
% KONO2 : O + NO2 = NO  ;
% KMT08 : NO2 + OH = HNO3  ;
% KMT07 : NO + OH = HONO  ;
% KHONOOH : HONO + OH = NO2  ;
% KO1DH2O : O1D + H2O = OH + OH  ;
% KO1DM : O1D + M = O  ;
% KCOOH : CO + OH = HO2  ;
% KHCHOOH : HCHO + OH = HO2 + CO  ;
% J<11> : HCHO = HO2 + HO2 + CO  ;
% J<12> : HCHO = CO  ;
% KHO2NO : HO2 + NO = NO2 + OH  ;
% KHO2HO2A : HO2 + HO2 = H2O2  ;
% KHO2HO2B : HO2 + HO2 = H2O2  ;
% KH2O2OH : H2O2 + OH = HO2  ;
% 4.8D-11*EXP(250/TEMP) : OH + HO2 = O2  ;
* ;
* ---- ② NO3/N2O5 夜化学 ([MCM] 行逐字拷贝) ----  ;
% J<5> : NO3 = NO  ;
% J<6> : NO3 = NO2 + O  ;
% KMT03 : NO2 + NO3 = N2O5  ;
% KMT04 : N2O5 = NO2 + NO3  ;
% 1.8D-11*EXP(110/TEMP) : NO + NO3 = NO2 + NO2  ;
% 4.50D-14*EXP(-1260/TEMP) : NO2 + NO3 = NO + NO2  ;
% 2.0D-11 : OH + NO3 = HO2 + NO2  ;
% 4.0D-12 : HO2 + NO3 = OH + NO2  ;
% 5.5D-16 : NO3 + HCHO = HNO3 + CO + HO2  ;
% 4.0D-04 : N2O5 = HNO3 + HNO3  ;
* ;
* ---- ③ CH4 氧化链 + PAN 储库 ----  ;
% KCH4OH : CH4 + OH = CH3O2  ;
% KCH3O2NO : CH3O2 + NO = CH3O + NO2  ;
% KCH3O2HO2 : CH3O2 + HO2 = CH3OOH  ;
% 1.03D-13*EXP(365/TEMP) : CH3O2 + CH3O2 = HCHO + HCHO + HO2 + HO2  ;
% J<41> : CH3OOH = CH3O + OH  ;
% 5.3D-12*EXP(190/TEMP)*0.4 : CH3OOH + OH = HCHO + OH  ;
% 7.3D-13*EXP(580/TEMP)*O2 : CH3O + O2 = HCHO + HO2  ;
% KCH3O2NO3 : CH3O2 + NO3 = CH3O + NO2  ;
% J<13> : CH3CHO = CH3O2 + CO + HO2  ;
% 4.7D-12*EXP(345/TEMP)*0.95 : CH3CHO + OH = CH3CO3  ;
% KNO3AL : CH3CHO + NO3 = HNO3 + CH3CO3  ;
% KFPAN : CH3CO3 + NO2 = PAN  ;
% KBPAN : PAN = CH3CO3 + NO2  ;
% 2.0D-11 : CH3CO3 + NO = CH3O2 + CO2 + NO2  ;
% KAPHO2*0.44 : CH3CO3 + HO2 = CH3O2 + CO2 + OH  ;
% 2.0D-12 : CH3CO3 + CH3O2 = HCHO + HO2 + CO2 + CH3O2  ;
* ;
* ---- ④ isoprene 完整二代链 ----  ;
* 初级氧化 (OH 主通道白天 / NO3 夜通道; O3 通道省略见头部注)  ;
% KISOPOH : ISOP + OH = ISOPBO2  ;
% KISOPNO3 : ISOP + NO3 = ISOPNO3  ;
% KISOPO3 : ISOP + O3 = 0.50 MVK + 0.50 MACR + 0.57 HCHO + 0.15 CH3CHO + 0.13 CO2 + 0.26 OH + 0.38 O2  ;
% KISOPBO2NO : ISOPBO2 + NO = 0.90 ISOPBO + 0.90 NO2 + 0.10 ISOPNIT  ;
% KRO2HO2*0.706 : ISOPBO2 + HO2 = ISOPOOH  ;
% KRO2NO3 : ISOPBO2 + NO3 = ISOPBO + NO2  ;
* 烷氧分解 → 一代羰基 (MVK/MACR 各半 + HCHO)  ;
% 7.3D-13*EXP(580/TEMP)*O2 : ISOPBO + O2 = 0.50 MVK + 0.50 MACR + HCHO + HO2  ;
* 氢过氧化物循环 (OH 回收 → 低 NOx 下 O3 生成效率维持)  ;
% J<21> : ISOPOOH = ISOPBO + OH  ;
% 1.9D-11 : ISOPOOH + OH = ISOPBO2  ;
* NO3 加成支链: 过氧硝酸酯 (NOx 储库) + 断裂通道  ;
% 4.0D-12 : ISOPNO3 + NO = MACR + HCHO + 2 NO2  ;
% KRO2HO2 : ISOPNO3 + HO2 = ISOPDNT  ;
* MVK 二代氧化 → CH3CO3 回灌  ;
% KMVKOH : MVK + OH = MVKO2  ;
% KRO2NO : MVKO2 + NO = MVKO + NO2  ;
% KRO2HO2*0.625 : MVKO2 + HO2 = MVKOOH  ;
% 1.90D-12*EXP(190/TEMP) : MVKOOH + OH = MVKO2  ;
% 7.3D-13*EXP(580/TEMP)*O2 : MVKO + O2 = CH3CO3 + HCHO + HCHO  ;
* MACR 二代氧化 → MPAN (经典 isoprene-O3 关联) + MGLY  ;
% KMACROH*0.47 : MACR + OH = MACRO2  ;
% KFPAN : MACRO2 + NO2 = MPAN  ;
% KMPANTH : MPAN = MACRO2 + NO2  ;
% 4.0D-12 : MACRO2 + NO = MACROO + NO2  ;
% 7.3D-13*EXP(580/TEMP)*O2 : MACROO + O2 = MGLY + CO + OH  ;
% KRO2HO2*0.625 : MACRO2 + HO2 = MACROOH  ;
* MGLY 终局: 光解 + OH → CH3CO3 回灌 (闭环)  ;
% J<22> : MGLY + 2 O2 = CH3CO3 + CO + HO2  ;
% KMGLYOH : MGLY + OH = CH3CO3 + CO  ;
* ;
* ---- ⑤ 硫链 ----  ;
% KSO2OH : SO2 + OH = SO3 + HO2  ;
% KSO3HYD : SO3 = H2SO4  ;
% KDMSOH : DMS + OH = MSA + CH3O2  ;
% KDMSNO3 : DMS + NO3 = MSA + CO + NO2  ;
* ;
* ---- ⑥ 卤素催化 O3 损耗 + 储库 ----  ;
% KCLO3 : Cl + O3 = ClO  ;
% KCLONO : ClO + NO = Cl + NO2  ;
% KCLONO2 : ClO + NO2 = ClONO2  ;
% J<26> : ClONO2 = Cl + NO3  ;
% KCLOHO2 : ClO + HO2 = HOCl  ;
% J<28> : HOCl = Cl + OH  ;
% KCLCH4 : Cl + CH4 = HCl + CH3O2  ;
% KCLHCHO : Cl + HCHO = HCl + HO2 + CO  ;
% KHCLOH : HCl + OH = Cl  ;
% KBRO3 : Br + O3 = BrO  ;
% KBRONO : BrO + NO = Br + NO2  ;
% KBRONO2 : BrO + NO2 = BrONO2  ;
% J<27> : BrONO2 = Br + NO3  ;
% KBROHO2 : BrO + HO2 = HOBr  ;
% J<29> : HOBr = Br + OH  ;
% KBRHCHO : Br + HCHO = HBr + HO2 + CO  ;
% KHBROH : HBr + OH = Br  ;
% J<24> : ClO = Cl + O  ;
% J<25> : BrO = Br + O  ;

* ---- ⑦ V2.2: VOC 降解谱集总类 (烯烃/烷烃/芳烃/酮/二羰基) ----  ;
% KOLEOH : OLE + OH = OLERO2 + O2  ;
% KOLEO3 : OLE + O3 = 1.35 HCHO + 0.75 CH3CHO + 0.15 CO2 + 0.30 OH + 0.15 O2  ;
% KOLENO3 : OLE + NO3 + H2O = OLERO2 + HNO3  ;
% 0.97*KRO2NO : OLERO2 + NO = 0.50 HCHO + CH3CHO + 0.50 CO + HO2 + NO2 + 0.50 H2  ;
% 0.03*KRO2NO : OLERO2 + NO = OLENIT  ;
% KRO2HO2 : OLERO2 + HO2 = OLEOOH  ;
% KALKOH : ALK + OH = ALKRO2 + H2O  ;
% 0.85*KRO2NO : ALKRO2 + NO = CH3CHO + HCHO + HO2 + NO2  ;
% 0.15*KRO2NO : ALKRO2 + NO = RONO2  ;
% KRO2HO2 : ALKRO2 + HO2 = ALKOOH + O2  ;
% KHCLOH : ALKOOH + OH = ALKRO2 + H2O  ;
% KARO1OH : ARO1 + OH = ARO1O2 + O2  ;
% KARO2OH : ARO2 + OH = ARO2O2 + O2  ;
% KRO2NO : ARO1O2 + NO + O2 = GLY + MGLY + CH3CO3 + NO2  ;
% KRO2NO : ARO2O2 + NO + 2.50 O2 = 0.50 GLY + MGLY + 2.00 CH3CO3 + NO2  ;
% KKETOH : KET + OH = KETRO2 + H2O  ;
% KRO2NO : KETRO2 + NO + O2 = CH3CO3 + HCHO + NO2  ;
% J<15> : KET = CH3CO3 + CH3O2 + 0.50 O2  ;
% J<16> : GLY = HCHO + CO  ;
* ---- ⑧ V2.2: 支撑化学补全 (PNA / N2O5 白天光解 / OH+HNO3) ----  ;
% KPNAF : HO2 + NO2 = PNA  ;
% KPNAT : PNA = HO2 + NO2  ;
% KOHPNA : PNA + OH = NO2 + O2 + H2O  ;
* ---- ⑨ V2.3: 烷基硝酸盐家族 (RONO2/OLENIT + ISOPNIT 去向) ----  ;
% KRONO2OH : RONO2 + OH = HNO3 + KET + 0.5 H2O + 0.25 O2  ;
% KOLENITOH : OLENIT + OH = HNO3 + OLERO2  ;
% KRONO2OH : ISOPNIT + OH = HNO3 + ISOPBO  ;
* ---- ⑩ V2.3: 单萜迷你链 (TERP: OH/O3/NO3 三入口, SOA 前体) ----  ;
% KTERPOH : TERP + OH = TERPRO2 + H2O  ;
% KTERPO3 : TERP + O3 = TERPCHO + 0.80 OH + 0.10 O2 + 0.60 H2  ;
% KTERPNO3 : TERP + NO3 = TERPNIT  ;
% KTERPOH : TERPRO2 + NO = TERPCHO + NO2 + 1.50 H2  ;
% KRO2HO2 : TERPRO2 + HO2 = TERPOOH  ;
% KRO2HO2 : TERPNIT + HO2 = TERPCHO + HNO3 + H2  ;

* TERPCHO = SOA 代理终产物 (汇走 drydep.config; 不设气相 OH 汇)  ;
% J<14> : N2O5 = NO2 + NO3  ;
% KMT11 : HNO3 + OH = NO3 + H2O  ;
% KRO2NO3 : ISOPBO2 + CH3O2 = ISOPBO + HCHO + HO2  ;
* ;
* ---- (11) V2.4 芳香烃分级 CSL + RO2+HO2 闭环补齐 ----  ;
% KCSLOH : CSL + OH + 1.5 O2 = 0.5 GLY + 2 MGLY  ;
% KCSLNO3 : CSL + NO3 + O2 = CSLRO2 + HNO3  ;
% KRO2NO : CSLRO2 + NO + 3 O2 = GLY + MGLY + 2 CO + NO2 + HO2  ;
% 0.15*KRO2NO : CSLRO2 + NO = CSLNIT  ;
% KRO2HO2 : CSLRO2 + HO2 = CSLOOH  ;
% KRO2HO2 : CSLOOH + OH = CSLRO2 + H2O + O2  ;
% KRO2HO2 : ARO1O2 + HO2 = TOLOOH  ;
% KRO2HO2 : ARO2O2 + HO2 = XYLOOH  ;
% KRO2HO2 : TOLOOH + OH = ARO1O2 + H2O + O2  ;
% KRO2HO2 : XYLOOH + OH = ARO2O2 + H2O + O2  ;
* ---- (12) V2.4 长链烷烃 LALK ----  ;
% KLALKOH : LALK + OH + O2 = LALKRO2 + H2O  ;
% 0.85*KRO2NO : LALKRO2 + NO + 2 O2 = 3 CH3CHO + NO2 + HO2  ;
% 0.15*KRO2NO : LALKRO2 + NO = LALKNIT  ;
% KRO2HO2 : LALKRO2 + HO2 = LALKOOH  ;
% KRO2HO2 : LALKOOH + OH = LALKRO2 + H2O + O2  ;
% KRONO2OH : LALKNIT + OH + 1.25 O2 = HNO3 + 3 CH3CHO + 0.5 H2O  ;
* ---- (13) V2.4 醇/醚/酯类含氧 VOC ----  ;
% KMEOHOH : MEOH + OH + O2 = HO2 + HCHO + H2O  ;
% KETOHOH : ETOH + OH + O2 = CH3CHO + HO2 + H2O  ;
% KMTBEOH : MTBE + OH + O2 = MTBERO2 + H2O  ;
% 0.85*KRO2NO : MTBERO2 + NO + 1.5 O2 = 2 CH3CHO + HCHO + NO2 + HO2  ;
% 0.15*KRO2NO : MTBERO2 + NO = MTBENIT  ;
% KRO2HO2 : MTBERO2 + HO2 = MTBEOOH  ;
% KRO2HO2 : MTBEOOH + OH = MTBERO2 + H2O + O2  ;
% KRONO2OH : MTBENIT + OH + 0.75 O2 = HNO3 + 2 CH3CHO + HCHO + 0.5 H2O  ;
% KESTEROH : ESTER + OH + 1.5 O2 = CH3CHO + CO2 + CH3O2 + H2O  ;
% 0.85*KRO2NO : ESTERO2 + NO + O2 = CH3CHO + CO2 + CH3O2 + NO2  ;
% 0.15*KRO2NO : ESTERO2 + NO = ESTERNIT  ;
% KRO2HO2 : ESTERO2 + HO2 = ESTEROOH  ;
% KRO2HO2 : ESTEROOH + OH = ESTERO2 + H2O + O2  ;
% KRONO2OH : ESTERNIT + OH + O2 = HNO3 + CH3CHO + CO2 + CH3O2  ;
* ---- (14) V2.4 倍半萜 SESQ ----  ;
% KSESQOH : SESQ + OH + 1.5 O2 = SESQRO2 + H2O  ;
% KSESQO3 : SESQ + O3 = SESQCHO + 0.80 OH + 0.10 O2 + 0.60 H2  ;
% KSESQNO3 : SESQ + NO3 + 0.75 O2 = SESQNIT + 0.5 H2O  ;
% 0.85*KRO2NO : SESQRO2 + NO + H2O + O2 = SESQCHO + NO2 + HO2 + H2O  ;
% 0.15*KRO2NO : SESQRO2 + NO = SESQNIT  ;
% KRO2HO2 : SESQRO2 + HO2 = SESQOOH  ;
% KRO2HO2 : SESQOOH + OH = SESQRO2 + H2O + O2  ;
% KRONO2OH : SESQNIT + OH + 0.25 O2 = HNO3 + SESQCHO + 0.5 H2O  ;
* ---- (15) V2.4 乙烯 ETH + 内烯烃 IOLE + 高级醛 ALD2 ----  ;
% KETHOH : ETH + OH + O2 = ETHO2  ;
% KETHO3 : ETH + O3 + 0.2 H2O = 2 HCHO + 0.4 OH + 0.4 O2  ;
% 0.85*KRO2NO : ETHO2 + NO + O2 = 2 HCHO + NO2 + HO2  ;
% 0.15*KRO2NO : ETHO2 + NO = ETHNIT  ;
% KRO2HO2 : ETHO2 + HO2 = ETHOOH  ;
% KRO2HO2 : ETHOOH + OH = ETHO2 + H2O + O2  ;
% KRONO2OH : ETHNIT + OH + 0.25 O2 = HNO3 + 2 HCHO + 0.5 H2O  ;
% KALD2OH : ALD2 + OH + O2 = ALD2O2 + H2O  ;
% KNO3AL : ALD2 + NO3 + 2.5 O2 = HNO3 + CH3CO3 + CO2 + H2O  ;
% J<13> : ALD2 + 0.5 O2 = CH3CHO + CO + H2  ;
% KRO2NO : ALD2O2 + NO + 2 O2 = CH3CO3 + CO2 + NO2 + H2O  ;
% KFPAN : ALD2O2 + NO2 = PPAN  ;
% KBPAN : PPAN = ALD2O2 + NO2  ;
% KRO2HO2 : ALD2O2 + HO2 = ALD2OOH  ;
% KRO2HO2 : ALD2OOH + OH = ALD2O2 + H2O + O2  ;
% KIOLEOH : IOLE + OH + O2 = IOLERO2  ;
% KIOLEO3 : IOLE + O3 = 2 HCHO + CH3CHO  ;
% KOLENO3 : IOLE + NO3 + 0.5 H2O + 0.25 O2 = IOLENIT  ;
% 0.85*KRO2NO : IOLERO2 + NO + O2 = 2 CH3CHO + HO2 + NO2  ;
% 0.15*KRO2NO : IOLERO2 + NO = IOLENIT  ;
% KRO2HO2 : IOLERO2 + HO2 = IOLEOOH  ;
% KRO2HO2 : IOLEOOH + OH = IOLERO2 + H2O + O2  ;
% KOLENITOH : IOLENIT + OH + 0.25 O2 = HNO3 + 2 CH3CHO + 0.5 H2O  ;
* ---- (16) V2.4 MACR 夜化学 ----  ;
% KNO3AL : MACR + NO3 + O2 = HNO3 + MACRO2  ;
* ---- (17) V2.4 RO2 交叉缔合 ----  ;
% KRO2NO3 : CH3CO3 + ISOPBO2 = CH3O2 + ISOPBO + CO2  ;
% KRO2NO3 : CH3O2 + MACRO2 = CH3O + MACROO + O2  ;
% KRO2NO3 : CH3O2 + MVKO2 = CH3O + MVKO + O2  ;
% KRO2NO3 : ISOPBO2 + MACRO2 = ISOPBO + MACROO + O2  ;
% KRO2NO3 : ETHO2 + CH3O2 = CH3O + 2 HCHO + HO2  ;
