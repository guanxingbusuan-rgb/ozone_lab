# 气象: 7 个量, 每个都可以写"常数"或 "file:constraints/xx.txt" 逐时序列
# ─────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────
# 现役默认 = **5 天连续晴天（clear-sky）逐时序列**（121 点/变量，含日循环）
#   生成约定: 晴空无云、无降水；T 05h≈22°C 17h≈33°C（逐日 +0.6K）；
#   RH 逆相 32–78%；BLH 夜间 180 m、14h 峰 ≈1800 m；JFAC=1.0（无云衰减）
#   切换"站点观测驱动"见文件末尾注释块；改回常数就直接写数值（如 TEMP = 303.15）
# 气象序列格式与 BC 序列相同 (t[s] + 值), 但不要写浓度单位指令行
# ─────────────────────────────────────────────────────────────────────
TEMP   = file:constraints/met_sunny5d_TEMP.txt
PRES   = file:constraints/met_sunny5d_PRES.txt
RH     = file:constraints/met_sunny5d_RH.txt
RADIAT = 0
BLH    = file:constraints/met_sunny5d_BLH.txt
RAIN   = file:constraints/met_sunny5d_RAIN.txt
JFAC   = file:constraints/met_sunny5d_JFAC.txt

# ═════════════════════════════════════════════════════════════════════
# 可选: 六变量全部走站点逐时序列 (样例在本目录 constraints/met_*_demo.txt)
# ─────────────────────────────────────────────────────────────────────
# 把上面 7 行换成下面 6 行即可; run.py 每轮自动重编译 runtime, 无需其它操作
#
#   TEMP   = file:constraints/met_TEMP_demo.txt   # K    气温
#   PRES   = file:constraints/met_PRES_demo.txt   # hPa  气压
#   RH     = file:constraints/met_RH_demo.txt     # %    相对湿度
#   BLH    = file:constraints/met_BLH_demo.txt    # m    边界层高度
#   RAIN   = file:constraints/met_RAIN_demo.txt   # mm/h 降水
#   JFAC   = file:constraints/met_JFAC_demo.txt   # 1    光解衰减 (云)
#   RADIAT = 0                                    # 当前无消费者, 留位
#
# 硬限制: 气象序列与 BC 序列共享 NSER_MAX=40 的序列池 (modules/runtime_dat_mod.f90)
# 启用 6 个气象序列后, BC 侧最多还能登记 34 条 file: 约束。
# ═════════════════════════════════════════════════════════════════════
